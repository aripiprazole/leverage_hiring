#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh"

usage() {
    cat <<'EOF'
Usage: scripts/smoke

Against a service already running through scripts/run, create and start a VM,
exercise SSH through Meier, then shut down and delete the VM.
EOF
}

if (($# > 0)); then
    case "$1" in
        help | --help | -h)
            usage
            exit 0
            ;;
        *)
            die "unexpected argument: $1"
            ;;
    esac
fi

require_linux
require_commands cmp curl grep jq sleep ssh timeout
require_runtime_artifacts
validate_timeout

API_URL="${BARBIROLLI_API_URL:-http://$ELHONE_ADDR}"
SSH_HOST="${BARBIROLLI_SSH_HOST:-127.0.0.1}"
SSH_PORT="${MEIER_ADDR##*:}"
[[ "$SSH_PORT" =~ ^[0-9]+$ ]] || die "cannot determine the SSH port from MEIER_ADDR=$MEIER_ADDR"

api_request_with_timeout() {
    local request_timeout="$1"
    local method="$2"
    local path="$3"
    local body="${4:-}"
    local arguments=(
        --fail
        --silent
        --show-error
        --max-time "$request_timeout"
        --request "$method"
    )
    if [[ -n "$body" ]]; then
        arguments+=(--header 'Content-Type: application/json' --data "$body")
    fi
    curl "${arguments[@]}" "$API_URL$path"
}

api_request() {
    api_request_with_timeout "$BARBIROLLI_COMMAND_TIMEOUT" "$@"
}

wait_for_api() {
    local deadline=$((SECONDS + BARBIROLLI_COMMAND_TIMEOUT))
    while ((SECONDS < deadline)); do
        if api_request GET /vms >/dev/null 2>&1; then
            return
        fi
        sleep 1
    done
    die "HTTP service at $API_URL did not become ready within ${BARBIROLLI_COMMAND_TIMEOUT}s"
}

VM_ID=""

cleanup_vm() {
    local status=$?
    trap - EXIT INT TERM
    if [[ -n "$VM_ID" ]]; then
        error "smoke test failed; attempting cleanup of VM $VM_ID"
        api_request_with_timeout 5 POST "/vms/$VM_ID/shutdown" >/dev/null 2>&1 || true
        api_request_with_timeout 5 DELETE "/vms/$VM_ID" >/dev/null 2>&1 || true
    fi
    exit "$status"
}

trap cleanup_vm EXIT
trap 'exit 130' INT TERM

wait_for_api

VM_USER="${BARBIROLLI_SMOKE_USER:-smoke-$(date +%s)-$$}"
PUBLIC_KEY="$(<"$DEFAULT_AUTHORIZED_KEYS")"
CREATE_BODY="$(
    jq -n \
        --arg user "$VM_USER" \
        --arg key "$PUBLIC_KEY" \
        '{
            user: $user,
            vcpu_count: 1,
            memory_mib: 256,
            kernel: "vmlinux",
            rootfs: "alpine.ext4",
            authorized_keys: [$key]
        }'
)"

info "creating VM for $VM_USER"
CREATE_RESPONSE="$(api_request POST /vms "$CREATE_BODY")"
VM_ID="$(jq -er '.id' <<<"$CREATE_RESPONSE")"

info "starting VM $VM_ID"
api_request POST "/vms/$VM_ID/start" >/dev/null

printf -v PROXY_COMMAND \
    'ssh -i %q -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -p %q -W %%h:%%p %q' \
    "$SSH_PRIVATE_KEY" \
    "$SSH_PORT" \
    "$VM_USER@$SSH_HOST"
SSH_OPTIONS=(
    -i "$SSH_PRIVATE_KEY"
    -o BatchMode=yes
    -o IdentitiesOnly=yes
    -o StrictHostKeyChecking=no
    -o UserKnownHostsFile=/dev/null
    -o ConnectionAttempts=1
    -o ConnectTimeout=3
    -o "ProxyCommand=$PROXY_COMMAND"
)

info "waiting for guest SSH"
SSH_DEADLINE=$((SECONDS + BARBIROLLI_COMMAND_TIMEOUT))
while ! run_with_timeout \
    "guest SSH readiness check" \
    ssh "${SSH_OPTIONS[@]}" root@vm true >/dev/null 2>&1; do
    ((SECONDS < SSH_DEADLINE)) ||
        die "guest SSH did not become ready within ${BARBIROLLI_COMMAND_TIMEOUT}s"
    sleep 1
done

info "checking SSH forwarding"
run_with_timeout \
    "SSH forwarding check" \
    ssh "${SSH_OPTIONS[@]}" root@vm uname -a

info "shutting down VM $VM_ID"
api_request POST "/vms/$VM_ID/shutdown" >/dev/null

info "deleting VM $VM_ID"
if ! api_request DELETE "/vms/$VM_ID" >/dev/null; then
    trap - EXIT INT TERM
    die "failed to delete VM $VM_ID"
fi

VM_ID=""
trap - EXIT INT TERM
info "smoke test passed"
