#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh"
source "$SCRIPT_DIR/lib/oci.sh"

usage() {
    cat <<'EOF'
Usage: x oci:run <name:tag>

Run one VM for an OCI image, pulling the image first when it is absent.

Example:
  x oci:run alpine:latest
EOF
}

if (($# == 0)); then
    usage_error "missing OCI image"
fi

case "$1" in
    help | --help | -h)
        usage
        exit 0
        ;;
esac

(($# == 1)) || usage_error "unexpected extra argument: $2"
require_commands curl jq
parse_oci_reference "$1"
api_request POST "/oci/run" "$(oci_pull_payload)"
