#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh"

usage() {
    cat <<'EOF'
Usage: x run_daemon

Build the daemon, then run it with the privileges required for KVM,
TAP, nftables, and IPv4 forwarding.
EOF
}

if (($# > 0)); then
    case "$1" in
        help | --help | -h)
            usage
            exit 0
            ;;
        *)
            usage_error "unexpected argument: $1"
            ;;
    esac
fi

require_linux
require_commands cargo cmp grep mkfs.ext4 sha256sum sudo
require_runtime_artifacts
[[ -e /dev/kvm ]] || die "/dev/kvm is unavailable inside this Lima guest"

mkdir -p "$VM_ROOT" "$CARGO_TARGET_DIR"

info "building the daemon"
(
    cd "$REPO_ROOT"
    cargo build
)

info "starting HTTP at $ELHONE_ADDR"
exec sudo \
    --preserve-env=VM_ROOT,IMAGE_ROOT,FIRECRACKER,ELHONE_ADDR,RUST_LOG,IDLE_INITIAL_INTERVAL_SECONDS,IDLE_STRIKE_INTERVAL_SECONDS,IDLE_FINAL_INTERVAL_SECONDS,IDLE_CPU_HIGH_PERCENT,IDLE_CPU_LOW_PERCENT \
    "$CARGO_TARGET_DIR/debug/ssh"
