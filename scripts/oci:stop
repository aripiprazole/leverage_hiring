#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh"
source "$SCRIPT_DIR/lib/oci.sh"

usage() {
    cat <<'EOF'
Usage: x oci:stop <name:tag>

Stop the image's VM while retaining its pulled root filesystem.

Example:
  x oci:stop alpine:latest
EOF
}

if (($# == 0)); then
    usage_error "missing OCI image"
fi

case "$1" in
    help | --help | -h)
        usage
        exit 0
        ;;
esac

(($# == 1)) || usage_error "unexpected extra argument: $2"
parse_oci_reference "$1"
api_request POST "/oci/stop" "$(oci_reference_payload)"
