#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh"

usage() {
    cat <<'EOF'
Usage: x vm:ssh [--identity <path>] <vm_id> [-- command...]

Open an SSH session into a running VM.

Options:
  --identity <path>  SSH private key to use. Defaults to the key from setup.
  --help, -h         Show this help message.

Examples:
  x vm:ssh 0
  x vm:ssh --identity ~/.ssh/personal.pem 0 -- ls -l
EOF
}

identity="$SSH_PRIVATE_KEY"
vm_id=""
remote_command=()
while (($# > 0)); do
    case "$1" in
        --identity)
            (($# < 2)) && usage_error "missing value for --identity"
            identity="$2"
            shift 2
            ;;
        --help | -h | help)
            usage
            exit 0
            ;;
        --)
            shift
            if (($# == 0)); then
                usage_error "missing remote command after --"
            fi
            remote_command=("$@")
            break
            ;;
        *)
            if [[ -z "$vm_id" ]]; then
                vm_id="$(require_vm_id "$1")"
                shift
                continue
            fi
            usage_error "unexpected argument: $1"
            ;;
    esac
done

if [[ -z "$vm_id" ]]; then
    usage_error "missing VM_ID"
fi

require_commands ssh jq curl

if [[ ! -f "$identity" || ! -r "$identity" ]]; then
    die "SSH identity file is missing or unreadable: $identity"
fi

summary="$(api_request GET "/vms/$vm_id")"

status="$(jq -er '.status' <<<"$summary" | tr '[:upper:]' '[:lower:]')"
if [[ "$status" != "running" ]]; then
    die "VM $vm_id is not running (status: $status). Run: x vm:start $vm_id"
fi

guest_ip="$(jq -er '.network.guest_ip' <<<"$summary")"

ssh_options=(
    -i "$identity"
    -o IdentitiesOnly=yes
    -o StrictHostKeyChecking=no
    -o UserKnownHostsFile=/dev/null
    -o ConnectTimeout=1
    -o ConnectionAttempts=1
)

ssh_ready=false
for ((attempt = 1; attempt <= 30; attempt++)); do
    if ssh "${ssh_options[@]}" -o BatchMode=yes "root@${guest_ip}" true \
        >/dev/null 2>&1; then
        ssh_ready=true
        break
    fi
    sleep 1
done

if [[ "$ssh_ready" != true ]]; then
    die "SSH did not become ready for VM $vm_id at $guest_ip within 30 seconds"
fi

if ((${#remote_command[@]} > 0)); then
    exec ssh \
        "${ssh_options[@]}" \
        "root@${guest_ip}" \
        "${remote_command[@]}"
fi

exec ssh \
    "${ssh_options[@]}" \
    "root@${guest_ip}"
