#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh"

usage() {
    cat <<'EOF'
Usage: x run <oci_manifest_url>

Fetch a public Docker Hub image for the host platform and verify all filesystem layers.

Example:
  x run https://registry-1.docker.io/v2/library/alpine/manifests/latest
EOF
}

docker_repository() {
    local manifest_url="$1"

    if [[ "$manifest_url" =~ ^https://registry-1\.docker\.io/v2/([^?#]+)/manifests/[^/?#]+$ ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
        return
    fi

    usage_error "expected a Docker Hub manifest URL, got: $manifest_url"
}

docker_public_token() {
    local repository="$1"
    local token

    if ! token="$(
        curl \
            --fail \
            --silent \
            --show-error \
            --get \
            --data-urlencode 'service=registry.docker.io' \
            --data-urlencode "scope=repository:$repository:pull" \
            'https://auth.docker.io/token' |
            jq -er '(.token // .access_token) | select(type == "string" and length > 0)'
    )"; then
        die "failed to fetch a Docker Hub public token for $repository"
    fi

    printf '%s\n' "$token"
}

if (($# == 0)); then
    usage_error "missing OCI manifest URL"
fi

case "$1" in
    help | --help | -h)
        usage
        exit 0
        ;;
    *)
        if (($# != 1)); then
            usage_error "unexpected extra argument: $2"
        fi
        require_commands curl jq
        manifest_url="$1"
        repository="$(docker_repository "$manifest_url")"
        token="$(docker_public_token "$repository")"
        payload="$(jq -nc --arg url "$manifest_url" --arg token "$token" '{url: $url, token: $token}')"
        api_request POST "/run" "$payload"
        ;;
esac
