{
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "cargo": {
          "target": "aarch64-unknown-linux-gnu",
          "buildScripts": {
            "overrideCommand": [
              "cargo",
              "check",
              "--target",
              "aarch64-unknown-linux-gnu",
              "--all-targets",
              "--message-format=json",
            ],
          },
        },
        "check": {
          "overrideCommand": [
            "cargo",
            "check",
            "--target",
            "aarch64-unknown-linux-gnu",
            "--all-targets",
            "--message-format=json",
          ],
        },
      },
    },
  },
}
