{
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "cargo": {
          "features": ["linux"],
          "target": "aarch64-unknown-linux-gnu",
          "buildScripts": {
            "overrideCommand": [
              "cargo",
              "check",
              "-p",
              "barbirolli",
              "--features",
              "linux",
              "--target",
              "aarch64-unknown-linux-gnu",
              "--all-targets",
              "--message-format=json"
            ]
          }
        },
        "check": {
          "overrideCommand": [
            "cargo",
            "check",
            "-p",
            "barbirolli",
            "--features",
            "linux",
            "--target",
            "aarch64-unknown-linux-gnu",
            "--all-targets",
            "--message-format=json"
          ]
        }
      }
    }
  }
}
